{
	servers {
		timeouts {
			read_header 10s
			read_body 10s
			write 30s
			idle 2m
		}
		max_header_size 16KB
	}
}

{$FLEETPULSE_PUBLIC_HOSTNAME} {
	# Live map's browser MQTT client (04-add-live-map, archived): mosquitto's
	# own websockets listener (docker/mosquitto/mosquitto.prod.conf) doesn't
	# route on path, so any path under /mqtt-ws works. Caddy upgrades the
	# connection to WS automatically -- no extra directive needed. The global
	# write timeout above does not apply to upgraded connections.
	handle /mqtt-ws* {
		reverse_proxy mosquitto:9001
	}

	handle /login {
		request_body {
			max_size 10KB
		}
		reverse_proxy api:8080
	}

	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy api:8080
	}
}
